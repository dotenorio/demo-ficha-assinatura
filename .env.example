# Copie para .env.local. Sem nada configurado, a demo roda em modo local (./.dados) com login de demo.
MODO_DEMO=true
# Login do painel (obrigatório se MODO_DEMO=false)
PAINEL_EMAIL=
PAINEL_SENHA=
# Obrigatório em produção: 32+ caracteres aleatórios
SESSAO_SEGREDO=
# Supabase (opcional): com isso, fichas vão para o PostgreSQL e PDFs para o Storage privado
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
